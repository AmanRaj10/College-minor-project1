version: '3.8'

services:
  solarai:
    build: .
    ports:
      - "8501:8501"
    volumes:
      - ./saved_model:/app/saved_model
      - ./data:/app/data
      - ./dataset.csv:/app/dataset.csv
    environment:
      - PYTHONUNBUFFERED=1
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8501/_stcore/health"]
      interval: 30s
      timeout: 10s
      retries: 3